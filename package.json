{
  "name": "bouncebound",
  "version": "0.5.0",
  "private": true,
  "description": "Bouncebound - a physics roguelite where bouncing is the combat system.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "tsx tools/balance-sim.ts",
    "pacing": "tsx tools/diagnose-rooms.ts",
    "soak": "tsx tools/soak.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "jsdom": "^30.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
